# Copy this file to .env and fill in real values for local development.

# Postgres (used by the db service and by Django's DATABASE_URL)
POSTGRES_DB=primevest
POSTGRES_USER=primevest
POSTGRES_PASSWORD=primevest

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://primevest:primevest@db:5432/primevest
CORS_ALLOWED_ORIGINS=http://localhost:3000
