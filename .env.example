# Copy this file to .env and fill in real values for local development.

# Postgres (used by the db service and by Django's DATABASE_URL)
POSTGRES_DB=primevest
POSTGRES_USER=primevest
POSTGRES_PASSWORD=primevest

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgres://primevest:primevest@db:5432/primevest
CORS_ALLOWED_ORIGINS=http://localhost:3000

# API route prefix and static/media URLs. Leave these at their defaults for local/Docker dev,
# where Django is its own origin. On cPanel, the Python app is mounted by Passenger at a /api
# base URI (which strips that segment before Django sees the request), so that deployment's
# .env instead sets: DJANGO_API_URL_PREFIX= (empty), DJANGO_STATIC_URL=/api/static/,
# DJANGO_MEDIA_URL=/api/media/
DJANGO_API_URL_PREFIX=api/
DJANGO_STATIC_URL=static/
DJANGO_MEDIA_URL=media/

# Site URL used in outbound emails (password reset links, etc.) and as the
# Paystack payment callback base.
SITE_URL=http://localhost:3000

# Email — defaults to printing emails to the backend container's console.
# For real delivery, switch to the SMTP backend and set your provider's
# credentials (e.g. SendGrid, Mailgun, Amazon SES, or plain SMTP).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Prime Vest <no-reply@primevest.com>

# Paystack (https://dashboard.paystack.com/#/settings/developer) — use test
# keys for local development. Card, Apple Pay, and Google Pay deposits go
# through Paystack; leave blank to disable card deposits (bank transfer still
# works without these).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Cryptocurrency deposits are a future-ready placeholder — flip to true once
# a crypto payment processor has been selected and wired up.
CRYPTO_PAYMENTS_ENABLED=false

# Google Analytics 4 measurement ID, also read by the frontend. Leave blank
# to disable analytics.
GA_MEASUREMENT_ID=
