# Copy this file to .env.local and fill in real values for local development.

# Public API base URL used by the browser (client components).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public site URL used for canonical links, sitemap, and OG metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID. Leave blank to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Paystack public key (test key is fine for local dev). Leave blank to disable
# the "pay by card" hint on the deposits page (the backend still needs
# PAYSTACK_SECRET_KEY set to actually process a payment).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Matches the backend's CRYPTO_PAYMENTS_ENABLED flag; controls whether the
# crypto deposit option is selectable in the UI ("true"/"false").
NEXT_PUBLIC_CRYPTO_PAYMENTS_ENABLED=false
